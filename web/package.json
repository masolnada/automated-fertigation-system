{
  "name": "hort-web",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:server": "cd apps/server && bun run start",
    "dev:dashboard": "cd apps/dashboard && bun run dev.ts",
    "build": "cd apps/dashboard && bun run build.ts",
    "test": "bun run test:server && bun run test:dom",
    "test:server": "NO_DOM=1 bun test apps/server",
    "test:dom": "bun test apps/dashboard packages",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/express": "^5.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "aedes": "^0.51.3",
    "bun-plugin-tailwind": "0.0.15",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "mqtt": "^5.14.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
