# Static dashboard served by Caddy (file_server). Generic build artifact:
# no MQTT, no env, no TLS. The ingress Caddy on the deploy host reverse-proxies
# to this on :8080 and owns TLS + the /api split.
FROM oven/bun:1 AS build
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile && cd apps/dashboard && bun run build.ts

FROM caddy:alpine
COPY --from=build /app/apps/dashboard/dist/ /srv/
# SPA-safe static serving on :8080 (unknown paths fall back to index.html).
RUN printf ':8080 {\n\troot * /srv\n\ttry_files {path} /index.html\n\tfile_server\n}\n' \
    > /etc/caddy/Caddyfile
