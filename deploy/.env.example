# Real values live in the age-encrypted secrets.enc.env (committed) and are
# decrypted to .env (gitignored) at deploy time. See README.md.

# Caddy DNS-01 (Cloudflare token scoped to the milverds.com zone)
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=

# Tailscale node "hort"
TAILSCALE_AUTHKEY=

# Broker credentials (same as the homelab mosquitto)
MQTT_USERNAME=
MQTT_PASSWORD=
